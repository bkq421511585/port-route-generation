{
  "name": "cruise-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "邮轮航线后台管理系统：航线港口配置 + 航线图生成（预览 / PNG 导出）",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node server/index.js\" \"vite\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "vue": "^3.4.31"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^8.2.2",
    "element-plus": "^2.7.6",
    "topojson-client": "^3.1.0",
    "vite": "^5.3.3"
  }
}
